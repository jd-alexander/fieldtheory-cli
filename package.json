{
  "name": "fieldtheory",
  "version": "1.3.20",
  "description": "Field Theory CLI. Self-custody for your X/Twitter bookmarks. Local sync, full-text search, classification, and terminal dashboards.",
  "type": "module",
  "bin": {
    "x-bookmark-sync": "bin/x-bookmark-sync.mjs",
    "ft": "bin/ft.mjs",
    "fieldtheory": "bin/ft.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "bin/",
    "dist/",
    "skills/x-bookmark-sync/",
    "docs/bookmark-sync.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afar1/fieldtheory-cli.git"
  },
  "keywords": [
    "bookmarks",
    "twitter",
    "x",
    "search",
    "fts5",
    "sqlite",
    "local-first",
    "self-custody",
    "cli"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "jsdom": "^26.1.0",
    "marked": "^18.1.3",
    "sql.js": "^1.14.1",
    "sql.js-fts5": "^1.4.0",
    "turndown": "^7.2.4",
    "undici": "^6.25.0",
    "unpdf": "^1.7.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
